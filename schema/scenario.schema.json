{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/usadamasa/apigap/main/schema/scenario.schema.json",
  "title": "apigap scenario",
  "description": "シナリオ YAML 1 ファイルの形。steps を上から順に実行する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "name": {
      "type": "string",
      "description": "シナリオ名。省略時はファイル名 (拡張子なし)。HAR の pageref に使う。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["navigate"],
        "properties": {
          "navigate": {
            "type": "string",
            "description": "開く URL。/ 始まりなら base_url に対する相対パス。fetch 系のステップは無い (Runtime ドメインを使うと Turnstile に検知されるため)。"
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 1,
            "default": 3000,
            "description": "ページが落ち着いてからさらに留まる時間 (ミリ秒)。遅延ロードの XHR を拾うため。"
          }
        }
      }
    }
  }
}
